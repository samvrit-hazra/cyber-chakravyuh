# ==========================================
# Cyber Chakravyuh — Environment Variables
# Copy this file to .env and fill in your keys
# ==========================================

# Database (MongoDB Atlas recommended for Render)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=cyber_chakravyuh

# AI / LLM (Groq API — ultra-fast Llama 3 inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Threat Intelligence APIs
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
GOOGLE_SAFE_BROWSING_API_KEY=your_gsb_api_key_here

# Web3 & Blockchain (Ethereum Sepolia)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_key
WEB3_PRIVATE_KEY=your_testnet_wallet_private_key_without_0x
CONTRACT_ADDRESS=0x_your_deployed_contract_address_here

# Backend Server (Local / Render)
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
