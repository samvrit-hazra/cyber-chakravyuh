# Cyber Chakravyuha - Frontend Environment Variables Example
# Copy this file to .env or .env.local for local frontend development

# Backend API Base URL (FastAPI Backend runs on port 8000)
VITE_API_BASE_URL=http://localhost:8000/api

# Backend Root URL for health check
VITE_BACKEND_ROOT_URL=http://localhost:8000

# Web3 / Blockchain Network RPC Endpoint
VITE_BLOCKCHAIN_RPC_URL=https://rpc.sepolia.org
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# App Environment Configuration
VITE_APP_ENV=development
VITE_ENABLE_MOCK_DATA=true
