# Cyber Chakravyuha - Frontend Environment Variables
# Copy this file to .env.local for local frontend development

# Backend API Base URL (FastAPI running on port 8000)
VITE_API_BASE_URL=http://localhost:8000/api
VITE_BACKEND_ROOT_URL=http://localhost:8000

# AI Intelligence & Threat Analysis Service URL (Optional / Direct)
VITE_AI_ENGINE_URL=http://localhost:8000/api

# Web3 / Blockchain Network RPC Endpoint (if smart contract telemetry is enabled)
VITE_BLOCKCHAIN_RPC_URL=https://rpc.sepolia.org
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# WebSocket / Realtime Threat Stream URL
VITE_WS_STREAM_URL=ws://localhost:8000/threat-stream

# App Environment Configuration
VITE_APP_ENV=development
VITE_ENABLE_MOCK_DATA=false
